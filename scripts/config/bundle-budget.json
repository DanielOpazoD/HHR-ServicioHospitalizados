{
  "entryMaxBytes": 700000,
  "chunkMaxBytes": 1250000,
  "startupChunkBudgets": [
    {
      "label": "entry-app",
      "source": "entry",
      "maxBytes": 120000,
      "severity": "error"
    },
    {
      "label": "firebase-core",
      "pattern": "^vendor-firebase-core-.*\\.js$",
      "maxBytes": 320000,
      "severity": "error"
    },
    {
      "label": "app-authenticated-shell",
      "pattern": "^app-authenticated-shell-.*\\.js$",
      "maxBytes": 525000,
      "severity": "error"
    },
    {
      "label": "firebase-firestore",
      "pattern": "^vendor-firebase-firestore-.*\\.js$",
      "maxBytes": 400000,
      "severity": "error"
    }
  ],
  "chunkPatternBudgets": [
    {
      "pattern": "^vendor-firebase-core-.*\\.js$",
      "maxBytes": 320000
    },
    {
      "pattern": "^vendor-firebase-firestore-.*\\.js$",
      "maxBytes": 400000
    },
    {
      "pattern": "^vendor-firebase-aux-.*\\.js$",
      "maxBytes": 120000
    },
    {
      "pattern": "^vendor-excel-(?!core-).*\\.js$",
      "maxBytes": 950000
    },
    {
      "pattern": "^TransferManagementView-.*\\.js$",
      "maxBytes": 750000
    }
  ]
}
