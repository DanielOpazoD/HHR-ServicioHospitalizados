{
  "entryMaxBytes": 700000,
  "chunkMaxBytes": 1250000,
  "startupChunkBudgets": [
    {
      "label": "entry-app",
      "source": "entry",
      "maxBytes": 120000,
      "severity": "error"
    },
    {
      "label": "firebase-core",
      "pattern": "^vendor-firebase-core-.*\\.js$",
      "maxBytes": 320000,
      "severity": "error"
    },
    {
      "label": "app-authenticated-shell",
      "pattern": "^app-authenticated-shell-.*\\.js$",
      "_comment": "Raised from 525000 to 560000 after the census public-split fix brought the chunk to ~483 KB. The 560 KB ceiling gives ~14% headroom for incremental post-merge growth (wound-care, new shell context providers) without another same-week refactor. Revisit if utilization exceeds 93%.",
      "maxBytes": 560000,
      "severity": "error"
    }
  ],
  "chunkPatternBudgets": [
    {
      "pattern": "^vendor-firebase-core-.*\\.js$",
      "maxBytes": 320000
    },
    {
      "pattern": "^vendor-firebase-firestore-.*\\.js$",
      "maxBytes": 500000
    },
    {
      "pattern": "^vendor-firebase-aux-.*\\.js$",
      "maxBytes": 120000
    },
    {
      "pattern": "^vendor-excel-(?!core-).*\\.js$",
      "maxBytes": 950000
    },
    {
      "pattern": "^TransferManagementView-.*\\.js$",
      "maxBytes": 750000
    }
  ]
}
