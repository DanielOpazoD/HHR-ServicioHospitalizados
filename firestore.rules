rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // ============================================
    // HELPER FUNCTIONS
    // ============================================
    
    // Check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }
    
    // Get user email
    function normalizeEmail(email) {
      return email.lower();
    }

    function getUserEmail() {
      return normalizeEmail(request.auth.token.email);
    }

    // Check if authenticated user has an email claim
    function hasEmail() {
      return isAuthenticated() && request.auth.token.email != null;
    }

    // Technical recovery allowlist. This is not the normal login/access source of truth.
    // It exists only as a bootstrap admin exception while config/roles remains the canonical model.
    function isBootstrapAdmin() {
      return hasEmail() &&
             getUserEmail() in [
               'daniel.opazo@hospitalhangaroa.cl',
               'd.opazo.damiani@gmail.com'
             ];
    }

	    function normalizeRole(role) {
	      return role == 'viewer_census'
	        ? 'viewer'
	        : role;
	    }

	    function getConfiguredRole() {
	      return hasEmail() &&
	             exists(/databases/$(database)/documents/config/roles)
	        ? normalizeRole(get(/databases/$(database)/documents/config/roles).data[getUserEmail()])
	        : null;
	    }

	    function getClaimRole() {
	      return isAuthenticated() &&
	             request.auth.token.keys().hasAny(['role']) &&
	             request.auth.token.role != null
	        ? normalizeRole(request.auth.token.role)
	        : null;
	    }

	    function getEffectiveRole() {
	      let configuredRole = getConfiguredRole();
	      return configuredRole != null
	        ? configuredRole
	        : getClaimRole();
	    }

	    function hasEffectiveRole(role) {
	      return isAuthenticated() && getEffectiveRole() == role;
	    }

	    function hasAnyEffectiveRole(roles) {
	      let effectiveRole = getEffectiveRole();
	      return isAuthenticated() &&
	             effectiveRole != null &&
	             roles.hasAny([effectiveRole]);
	    }
	    
	    function isAdmin() {
	      return isBootstrapAdmin() || hasEffectiveRole('admin');
	    }
	    
	    function isNurse() {
	      return isAdmin() || hasEffectiveRole('nurse_hospital');
	    }

	    function isDoctor() {
	      return isAdmin() || hasEffectiveRole('doctor_urgency');
	    }

	    function isDoctorSpecialist() {
	      return isAdmin() || hasEffectiveRole('doctor_specialist');
	    }
	    
	    // Check if user can edit (admin or nurse)
	    function canEdit() {
	      return isBootstrapAdmin() || hasAnyEffectiveRole(['admin', 'nurse_hospital']);
	    }

	    function canReportSystemHealth() {
	      return isBootstrapAdmin() || hasAnyEffectiveRole(['admin', 'nurse_hospital']);
	    }

	    function isEditorRole() {
		      return hasEffectiveRole('editor');
		    }

    function isValidSpecialistClinicalCribMedicalUpdate(beforeCrib, afterCrib) {
      return beforeCrib != null &&
             afterCrib != null &&
             afterCrib.diff(beforeCrib).affectedKeys().hasOnly([
               'medicalHandoffEntries',
               'medicalHandoffNote',
               'medicalHandoffAudit',
               'clinicalEvents'
             ]);
    }

    function isValidSpecialistMedicalBedRootUpdate(beforeBed, afterBed) {
      let affectedBedKeys = afterBed.diff(beforeBed).affectedKeys();

      return affectedBedKeys.hasOnly([
               'medicalHandoffEntries',
               'medicalHandoffNote',
               'medicalHandoffAudit',
               'clinicalEvents'
             ]);
    }

    function isValidSpecialistMedicalBedClinicalCribUpdate(beforeBed, afterBed) {
      let affectedBedKeys = afterBed.diff(beforeBed).affectedKeys();

      return affectedBedKeys.hasOnly(['clinicalCrib']) &&
             isValidSpecialistClinicalCribMedicalUpdate(beforeBed.clinicalCrib, afterBed.clinicalCrib);
    }

    function isValidSpecialistMedicalBedUpdate(bedId) {
      let beforeBed = resource.data.beds[bedId];
      let afterBed = request.resource.data.beds[bedId];

      return beforeBed != null &&
             afterBed != null &&
             (
               isValidSpecialistMedicalBedRootUpdate(beforeBed, afterBed) ||
               isValidSpecialistMedicalBedClinicalCribUpdate(beforeBed, afterBed)
             );
    }

    function isOnlySpecialistAffectedBed(affectedBedIds, bedId) {
      return affectedBedIds.size() == 1 &&
             affectedBedIds.hasOnly([bedId]) &&
             isValidSpecialistMedicalBedUpdate(bedId);
    }

    function getSpecialistStructuredBeforeBySpecialty() {
      return resource.data.medicalHandoffBySpecialty == null
        ? {}
        : resource.data.medicalHandoffBySpecialty;
    }

    function getSpecialistStructuredAfterBySpecialty() {
      return request.resource.data.medicalHandoffBySpecialty == null
        ? {}
        : request.resource.data.medicalHandoffBySpecialty;
    }

    function hasOnlySpecialistStructuredRecordKeys(affectedRecordKeys) {
      return affectedRecordKeys.hasOnly([
        'medicalHandoffBySpecialty',
        'medicalHandoffNovedades',
        'lastUpdated',
        'dateTimestamp'
      ]);
    }

    function hasOnlySpecialistMedicalHandoffRecordKeys(affectedRecordKeys) {
      return affectedRecordKeys.hasOnly(['beds', 'lastUpdated', 'dateTimestamp']) ||
             hasOnlySpecialistStructuredRecordKeys(affectedRecordKeys);
    }

    function isAllowedSpecialistStructuredSpecialty(specialty) {
      return [
        'cirugia',
        'traumatologia',
        'ginecobstetricia',
        'pediatria',
        'psiquiatria',
        'medicinaInterna'
      ].hasAny([specialty]);
    }

    function isOnlyAffectedSpecialistStructuredSpecialty(affectedSpecialties, specialty) {
      return affectedSpecialties.size() == 1 &&
             affectedSpecialties.hasOnly([specialty]) &&
             isAllowedSpecialistStructuredSpecialty(specialty) &&
             isValidSpecialistStructuredMedicalSpecialtyEntry(specialty);
    }

    function isAnyAllowedSpecialistStructuredSpecialtyAffected(affectedSpecialties) {
      return isOnlyAffectedSpecialistStructuredSpecialty(affectedSpecialties, 'cirugia') ||
             isOnlyAffectedSpecialistStructuredSpecialty(affectedSpecialties, 'traumatologia') ||
             isOnlyAffectedSpecialistStructuredSpecialty(affectedSpecialties, 'ginecobstetricia') ||
             isOnlyAffectedSpecialistStructuredSpecialty(affectedSpecialties, 'pediatria') ||
             isOnlyAffectedSpecialistStructuredSpecialty(affectedSpecialties, 'psiquiatria') ||
             isOnlyAffectedSpecialistStructuredSpecialty(affectedSpecialties, 'medicinaInterna');
    }

    function isAnySpecialistAffectedBed(affectedBedIds) {
      return isOnlySpecialistAffectedBed(affectedBedIds, 'R1') ||
             isOnlySpecialistAffectedBed(affectedBedIds, 'R2') ||
             isOnlySpecialistAffectedBed(affectedBedIds, 'R3') ||
             isOnlySpecialistAffectedBed(affectedBedIds, 'R4') ||
             isOnlySpecialistAffectedBed(affectedBedIds, 'NEO1') ||
             isOnlySpecialistAffectedBed(affectedBedIds, 'NEO2') ||
             isOnlySpecialistAffectedBed(affectedBedIds, 'H1C1') ||
             isOnlySpecialistAffectedBed(affectedBedIds, 'H1C2') ||
             isOnlySpecialistAffectedBed(affectedBedIds, 'H2C1') ||
             isOnlySpecialistAffectedBed(affectedBedIds, 'H2C2') ||
             isOnlySpecialistAffectedBed(affectedBedIds, 'H3C1') ||
             isOnlySpecialistAffectedBed(affectedBedIds, 'H3C2') ||
             isOnlySpecialistAffectedBed(affectedBedIds, 'H4C1') ||
             isOnlySpecialistAffectedBed(affectedBedIds, 'H4C2') ||
             isOnlySpecialistAffectedBed(affectedBedIds, 'H5C1') ||
             isOnlySpecialistAffectedBed(affectedBedIds, 'H5C2') ||
             isOnlySpecialistAffectedBed(affectedBedIds, 'H6C1') ||
             isOnlySpecialistAffectedBed(affectedBedIds, 'H6C2') ||
             isOnlySpecialistAffectedBed(affectedBedIds, 'E1') ||
             isOnlySpecialistAffectedBed(affectedBedIds, 'E2') ||
             isOnlySpecialistAffectedBed(affectedBedIds, 'E3') ||
             isOnlySpecialistAffectedBed(affectedBedIds, 'E4') ||
             isOnlySpecialistAffectedBed(affectedBedIds, 'E5');
    }

    function isValidSpecialistStructuredMedicalSpecialtyEntry(specialty) {
      let beforeEntry = getSpecialistStructuredBeforeBySpecialty()[specialty];
      let afterEntry = getSpecialistStructuredAfterBySpecialty()[specialty];

      return afterEntry != null &&
             (
               beforeEntry == null ||
               afterEntry.diff(beforeEntry).affectedKeys().hasOnly([
                 'note',
                 'createdAt',
                 'updatedAt',
                 'author',
                 'lastEditor',
                 'version',
                 'dailyContinuity'
               ])
             );
    }

    function isSpecialistStructuredMedicalHandoffUpdate() {
      let affectedRecordKeys = request.resource.data.diff(resource.data).affectedKeys();
      let affectedSpecialties =
        getSpecialistStructuredAfterBySpecialty()
          .diff(getSpecialistStructuredBeforeBySpecialty())
          .affectedKeys();

      return hasOnlySpecialistStructuredRecordKeys(affectedRecordKeys) &&
             isAnyAllowedSpecialistStructuredSpecialtyAffected(affectedSpecialties);
    }

    function isSpecialistMedicalHandoffPayload() {
      let affectedRecordKeys = request.resource.data.diff(resource.data).affectedKeys();
      let affectedBedIds = request.resource.data.beds.diff(resource.data.beds).affectedKeys();
      let now = request.time.toMillis();
      let currentRecordTimestamp = resource.data.dateTimestamp;
      let nextRecordTimestamp = request.resource.data.dateTimestamp;
      let effectiveRecordTimestamp =
        nextRecordTimestamp != null
          ? nextRecordTimestamp
          : currentRecordTimestamp;

      // Grace mode for legacy records without dateTimestamp.
      // Otherwise keep the normal 24h write window for specialist handoff.
      let isWithinSpecialistWindow =
        effectiveRecordTimestamp == null ||
        (now >= effectiveRecordTimestamp && now < (effectiveRecordTimestamp + 86400000));

      return isWithinSpecialistWindow &&
             hasOnlySpecialistMedicalHandoffRecordKeys(affectedRecordKeys) &&
             (
               isSpecialistStructuredMedicalHandoffUpdate() ||
               isAnySpecialistAffectedBed(affectedBedIds)
             );
    }

    function isSpecialistClinicalDocumentDraftWrite() {
      return isDoctorSpecialist() &&
             request.resource.data.status == 'draft' &&
             (
               resource == null ||
               resource.data == null ||
               resource.data.status == 'draft'
             );
    }

	    function isGeneralViewer() {
	      return hasEffectiveRole('viewer');
	    }

	    // Consolidated read access for clinical data
	    function canReadClinicalData() {
	      return isBootstrapAdmin() ||
	             hasAnyEffectiveRole([
	               'admin',
	               'nurse_hospital',
	               'doctor_urgency',
	               'doctor_specialist',
	               'editor',
	               'viewer'
	             ]);
	    }

	    function canManageCensusAccess() {
	      return isBootstrapAdmin() || hasAnyEffectiveRole(['admin', 'editor']);
	    }

    function isInvitationOwner() {
      return hasEmail() &&
             resource != null &&
             resource.data != null &&
             resource.data.email == getUserEmail();
    }

    function isValidInvitationClaim() {
      let affectedKeys = request.resource.data.diff(resource.data).affectedKeys();

      return isAuthenticated() &&
             isInvitationOwner() &&
             resource.data.status == 'pending' &&
             (resource.data.expiresAt == null || request.time.toMillis() <= resource.data.expiresAt) &&
             affectedKeys.hasOnly(['status', 'usedBy', 'usedAt']) &&
             request.resource.data.status == 'used' &&
             request.resource.data.usedBy == request.auth.uid &&
             request.resource.data.usedAt is int;
    }

    function isValidCensusAccessUserWrite(userId) {
      let payload = request.resource.data;

      return payload.id == userId &&
             payload.email is string &&
             payload.role in ['viewer', 'editor', 'admin'] &&
             payload.isActive is bool;
    }

    function canReadCensusAccessLog(logOwnerId) {
      return isAdmin() || (isAuthenticated() && request.auth.uid == logOwnerId);
    }

    function isValidOwnCensusAccessLog() {
      let payload = request.resource.data;

      return isAuthenticated() &&
             hasEmail() &&
             payload.keys().hasOnly(['userId', 'email', 'action', 'timestamp']) &&
             payload.userId == request.auth.uid &&
             payload.email == getUserEmail() &&
             payload.action is string &&
             payload.timestamp is int;
    }

    function isOptionalString(payload, key) {
      return !(key in payload) || payload[key] == null || payload[key] is string;
    }

    function isOptionalBool(payload, key) {
      return !(key in payload) || payload[key] == null || payload[key] is bool;
    }

    function isOptionalBoundedInt(payload, key, maxValue) {
      return !(key in payload) ||
             payload[key] == null ||
             (payload[key] is int && payload[key] >= 0 && payload[key] <= maxValue);
    }

    function isOptionalEnum(payload, key, allowedValues) {
      return !(key in payload) ||
             payload[key] == null ||
             allowedValues.hasAny([payload[key]]);
    }

    // System health payload guard:
    // - caller can only write own doc
    // - schema is constrained
    // - numeric counters are bounded to non-negative values
    function isValidSystemHealthWrite(userId) {
      let payload = request.resource.data;
      return isAuthenticated() &&
             request.auth.uid == userId &&
             payload.keys().hasOnly([
               'uid',
               'email',
               'displayName',
               'lastSeen',
               'isOnline',
               'isOutdated',
               'pendingMutations',
               'pendingSyncTasks',
               'failedSyncTasks',
               'conflictSyncTasks',
               'retryingSyncTasks',
               'syncOrphanedTasks',
               'oldestPendingAgeMs',
               'remoteSyncReason',
               'versionUpdateReason',
               'localErrorCount',
               'degradedLocalPersistence',
               'repositoryWarningCount',
               'slowestRepositoryOperationMs',
               'operationalObservedCount',
               'operationalFailureCount',
               'operationalRetryableCount',
               'operationalRecoverableCount',
               'operationalDegradedCount',
               'operationalBlockedCount',
               'operationalUnauthorizedCount',
               'operationalLastHourObservedCount',
               'operationalSyncObservedCount',
               'operationalIndexedDbObservedCount',
               'operationalClinicalDocumentObservedCount',
               'operationalCreateDayObservedCount',
               'operationalHandoffObservedCount',
               'operationalExportBackupObservedCount',
               'operationalDailyRecordRecoveredRealtimeNullCount',
               'operationalDailyRecordConfirmedRealtimeNullCount',
               'operationalSyncReadUnavailableCount',
               'operationalIndexedDbFallbackModeCount',
               'operationalAuthBootstrapTimeoutCount',
               'operationalTopObservedCategory',
               'operationalTopObservedOperation',
               'latestOperationalOperation',
               'latestOperationalRuntimeState',
               'latestOperationalIssueAt',
               'appVersion',
               'platform',
               'userAgent'
             ]) &&
             payload.uid == request.auth.uid &&
             isOptionalString(payload, 'email') &&
             isOptionalString(payload, 'displayName') &&
             isOptionalString(payload, 'lastSeen') &&
             isOptionalBool(payload, 'isOnline') &&
             isOptionalBool(payload, 'isOutdated') &&
             isOptionalBoundedInt(payload, 'pendingMutations', 10000) &&
             isOptionalBoundedInt(payload, 'pendingSyncTasks', 10000) &&
             isOptionalBoundedInt(payload, 'failedSyncTasks', 10000) &&
             isOptionalBoundedInt(payload, 'conflictSyncTasks', 10000) &&
             isOptionalBoundedInt(payload, 'retryingSyncTasks', 10000) &&
             isOptionalBoundedInt(payload, 'syncOrphanedTasks', 10000) &&
             isOptionalBoundedInt(payload, 'oldestPendingAgeMs', 864000000) &&
             isOptionalEnum(payload, 'remoteSyncReason', [
               'ready',
               'auth_loading',
               'auth_connecting',
               'auth_unavailable',
               'manual_override',
               'offline',
               'runtime_unavailable'
             ]) &&
             isOptionalEnum(payload, 'versionUpdateReason', [
               'current',
               'new_build_available',
               'runtime_contract_mismatch',
               'schema_ahead_of_client'
             ]) &&
             isOptionalBoundedInt(payload, 'localErrorCount', 10000) &&
             isOptionalBool(payload, 'degradedLocalPersistence') &&
             isOptionalBoundedInt(payload, 'repositoryWarningCount', 10000) &&
             isOptionalBoundedInt(payload, 'slowestRepositoryOperationMs', 864000000);
    }
    
    // Check if a date (ms timestamp) is within the editing window (+/- 1 day)
    // Nurse window: Can edit yesterday, today and tomorrow.
    // Calculation: (CurrentTime - RecordTime) should be between -24h and +48h
    // If dateTimestamp is null (legacy record), allow the edit (grace mode)
    function isWithinEditingWindow(recordTS) {
      let now = request.time.toMillis();
      // Legacy records without dateTimestamp are allowed (they'll be fixed on save)
      return recordTS == null || (
             now > (recordTS - 86400000) && 
             now < (recordTS + 172800000)
      );
    }

    // Check if the update is only for medical signature fields
    function isMedicalUpdate() {
      let affectedKeys = request.resource.data.diff(resource.data).affectedKeys();
      return affectedKeys.hasOnly([
        'medicalSignature',
        'medicalSignatureByScope',
        'medicalHandoffDoctor',
        'medicalHandoffSentAt',
        'medicalHandoffSentAtByScope',
        'medicalSignatureLinkTokenByScope',
        'lastUpdated'
      ]);
    }

    function canUpdatePersistedDailyRecord() {
      let effectiveRole = getEffectiveRole();

      return isBootstrapAdmin() ||
             (
               effectiveRole == 'admin'
                 ? true
                 : effectiveRole == 'nurse_hospital'
                   ? request.resource.data.keys().hasAll(['dateTimestamp']) &&
                     request.resource.data.dateTimestamp != null &&
                     isWithinEditingWindow(request.resource.data.dateTimestamp)
                   : effectiveRole == 'doctor_urgency'
                     ? isMedicalUpdate()
                     : effectiveRole == 'doctor_specialist'
                       ? isSpecialistMedicalHandoffPayload()
                       : false
             );
    }
    
    // ============================================
    // HOSPITALS COLLECTION (Main hierarchy)
    // ============================================
    match /hospitals/{hospitalId} {
      // Hospital document itself
      allow read: if canReadClinicalData();
      allow write: if isAdmin();
      
      // ----------------------------------------
      // DAILY RECORDS (Census Data)
      // ----------------------------------------
      match /dailyRecords/{date} {
        allow read: if canReadClinicalData();
        // Create: Admin or Nurse
        allow create: if canEdit();
        // Update: Admin siempre, Enfermero en ventana, o Médico solo campos de firma
        allow update: if exists(/databases/$(database)/documents/hospitals/$(hospitalId)/dailyRecords/$(date)) &&
                         canUpdatePersistedDailyRecord();
        // Delete: Admin only (nurses must not hard-delete census records)
        allow delete: if isAdmin();
        
        // History subcollection
        match /history/{historyId} {
          allow read: if canReadClinicalData();
          allow create: if canEdit();
          allow update, delete: if isAdmin();
        }
      }

      // Deleted Records (Trash)
      match /deletedRecords/{trashId} {
        allow read, write: if isAdmin();
      }
      
      // ----------------------------------------
      // CLINICAL DOCUMENTS
      // ----------------------------------------
      match /clinicalDocuments/{documentId} {
        allow read: if canReadClinicalData();
        allow create: if isAdmin() || isDoctor() || isSpecialistClinicalDocumentDraftWrite();
        allow update: if isAdmin() || isDoctor() || isSpecialistClinicalDocumentDraftWrite();
        allow delete: if isAdmin() || isDoctor() || isNurse() || isEditorRole();
      }

      // ----------------------------------------
      // CLINICAL DOCUMENT TEMPLATES
      // ----------------------------------------
      match /clinicalDocumentTemplates/{templateId} {
        allow read: if canReadClinicalData();
        allow write: if isAdmin();
      }

      // ----------------------------------------
      // SETTINGS (Nurses, TENS, TableConfig)
      // ----------------------------------------
      match /settings/{settingId} {
        allow read: if canReadClinicalData();
        // Allow both Admins and Nurses to update catalogs and settings
        allow write: if canEdit();
      }

      // ----------------------------------------
      // REMINDERS / STAFF NOTICES
      // ----------------------------------------
      match /reminders/{reminderId} {
        allow read: if canReadClinicalData();
        allow create, update, delete: if isAdmin();

	        match /readReceipts/{receiptId} {
	          allow read: if isAdmin() ||
	                       (isAuthenticated() && resource.data.userId == request.auth.uid);
	          allow create, update: if isAdmin() || (
	                                isAuthenticated() &&
	                                request.resource.data.userId == request.auth.uid &&
	                                request.resource.data.userName is string &&
	                                request.resource.data.readAt is string &&
	                                request.resource.data.shift in ['day', 'night'] &&
	                                request.resource.data.dateKey is string
	                              );
	          allow delete: if isAdmin();
	        }
      }
      
      // ----------------------------------------
      // EXPORT PASSWORDS
      // ----------------------------------------
      match /exportPasswords/{passwordId} {
        allow read: if canReadClinicalData();
        allow write: if isAdmin();
      }
      
      // ----------------------------------------
      // AUDIT LOGS (Hospital-level)
      // ----------------------------------------
      match /auditLogs/{logId} {
        allow read: if isAdmin();
        allow create: if canReadClinicalData();
        // Allow admins to update or delete during consolidation/maintenance
        allow update, delete: if isAdmin();
      }
      
      // ----------------------------------------
      // TRANSFER REQUESTS (Patient transfers)
      // ----------------------------------------
      match /transferRequests/{transferId} {
        allow read: if canReadClinicalData();
        allow create: if canEdit();
        allow update: if canEdit();
        allow delete: if isAdmin();
      }
      
      // ----------------------------------------
      // TRANSFER HISTORY (Completed transfers)
      // ----------------------------------------
      match /transferHistory/{transferId} {
        allow read: if canReadClinicalData();
        allow create: if canEdit();
        allow update, delete: if isAdmin();
      }
      
      // ----------------------------------------
      match /bookmarks/{bookmarkId} {
        allow read: if canReadClinicalData();
        allow write: if canReadClinicalData();
      }

      // ----------------------------------------
      // BACKUP FILES (Cloud backup archives)
      // ----------------------------------------
      match /backupFiles/{fileId} {
        allow read: if canReadClinicalData();
        allow create: if canEdit();
        allow update: if isAdmin();
        allow delete: if isAdmin();
      }

      // ----------------------------------------
      // PATIENT MASTER INDEX
      // ----------------------------------------
      match /patients/{rut} {
        allow read: if canReadClinicalData();
        allow write: if canEdit();
      }
    }
    
    // ============================================
    // TOP-LEVEL AUDIT LOGS (Legacy/Fallback)
    // ============================================
    match /auditLogs/{logId} {
      allow read: if isAdmin();
      allow create: if canReadClinicalData();
      // Allow admins to update or delete during consolidation/maintenance
      allow update, delete: if isAdmin();
    }
    
    // ============================================
    // ALLOWED USERS (Legacy retired)
    // ============================================
    match /allowedUsers/{userId} {
      allow read, write: if false;
    }
    
    // ============================================
    // STAFF CATALOGS (Legacy - if still used)
    // ============================================
    match /staffCatalogs/{catalogType} {
      allow read: if canReadClinicalData();
      allow write: if isAdmin();
    }
    
    // ============================================
    // USER SETTINGS
    // ============================================
    match /userSettings/{userId} {
      allow read: if isAuthenticated() && (request.auth.uid == userId || isAdmin());
      allow write: if isAuthenticated() && (request.auth.uid == userId || isAdmin());
    }
    
    // ============================================
    // WHATSAPP INTEGRATION
    // ============================================
    match /whatsapp/{docId} {
      allow read: if canReadClinicalData();
      allow write: if isAdmin();
    }
    
    match /whatsappLogs/{logId} {
      allow read: if isAdmin();
      allow create: if canReadClinicalData();
      allow update, delete: if false;
    }
    
    match /whatsappMessages/{messageId} {
      allow read, write: if isAdmin();
    }
    
    match /shifts/{path=**} {
      allow read: if canReadClinicalData();
      allow write: if isAdmin();
    }
    
    // ============================================
    // SYSTEM HEALTH
    // ============================================
    match /stats/system_health/users/{userId} {
      allow read: if canReportSystemHealth();
      allow create, update: if isValidSystemHealthWrite(userId);
      allow delete: if false;
    }

    // ============================================
    // SYSTEM CONFIGURATION
    // ============================================
    match /emailRecipientLists/{listId} {
      allow read: if canReadClinicalData();
      allow write: if canEdit() || isEditorRole();
    }

    match /config/roles {
      allow read, write: if isAdmin();
    }

    match /census-access-invitations/{invitationId} {
      allow read: if canManageCensusAccess() || isInvitationOwner();
      allow create, delete: if canManageCensusAccess();
      allow update: if canManageCensusAccess() || isValidInvitationClaim();
    }

    match /census-access-users/{userId} {
      allow read: if canManageCensusAccess();
      allow create, update: if canManageCensusAccess() && isValidCensusAccessUserWrite(userId);
      allow delete: if canManageCensusAccess();
    }

    match /census-access-logs/{logId} {
      allow read: if resource != null &&
                   resource.data != null &&
                   canReadCensusAccessLog(resource.data.userId);
      allow create: if isValidOwnCensusAccessLog();
      allow update, delete: if false;
    }

    // ============================================
    // DENY ALL OTHER BY DEFAULT
    // ============================================
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
