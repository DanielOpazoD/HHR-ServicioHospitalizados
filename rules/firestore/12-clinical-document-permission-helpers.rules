    // 1.5 Clinical document write/delete permissions
    // ---------------------------------------------

    function isSpecialistClinicalDocumentDraftWrite() {
      return isDoctorSpecialist() &&
             request.resource.data.status == 'draft' &&
             (
               resource == null ||
               resource.data == null ||
               resource.data.status == 'draft'
             );
    }

    function canWriteClinicalDocument() {
      return isAdmin() || isDoctor() || isSpecialistClinicalDocumentDraftWrite();
    }

    function canDeleteClinicalDocument() {
      return canWriteClinicalDocument() || isNurse() || isEditorRole();
    }

